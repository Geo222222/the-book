{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://the-book.local/contracts/zlj-intelligence/1.0",
  "title": "ZLJIntelligenceV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "intelligence_id",
    "instrument",
    "horizon_ms",
    "proposition",
    "probability",
    "expected_move_bps",
    "market_state",
    "regime",
    "model_ids",
    "qualification_state",
    "competence_refs",
    "evidence_refs",
    "code_version",
    "feature_version",
    "invalidation_conditions",
    "known_at",
    "valid_until"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "intelligence_id": {"type": "string", "minLength": 1},
    "instrument": {"type": "string", "minLength": 1},
    "horizon_ms": {"type": "integer", "minimum": 1},
    "proposition": {"type": "string", "minLength": 1},
    "probability": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "expected_move_bps": {"type": ["number", "null"]},
    "market_state": {"type": ["string", "null"]},
    "regime": {"type": ["string", "null"]},
    "model_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "qualification_state": {"enum": ["QUALIFIED", "DEGRADED", "BLOCKED"]},
    "competence_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "evidence_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "code_version": {"type": ["string", "null"]},
    "feature_version": {"type": ["string", "null"]},
    "invalidation_conditions": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "known_at": {"type": "string", "format": "date-time"},
    "valid_until": {"type": ["string", "null"], "format": "date-time"}
  }
}
