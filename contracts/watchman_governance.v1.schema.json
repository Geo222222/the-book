{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://the-book.local/contracts/watchman-governance/1.0",
  "title": "WatchmanGovernanceV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "governance_id",
    "decision_receipt_id",
    "decision_id",
    "result",
    "policy_version",
    "checks",
    "capability_constraints",
    "evaluated_at",
    "expires_at"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "governance_id": {"type": "string", "minLength": 1},
    "decision_receipt_id": {"type": "string", "minLength": 1},
    "decision_id": {"type": "string", "minLength": 1},
    "result": {"enum": ["AUTHORIZE", "BLOCK"]},
    "policy_version": {"type": "string", "minLength": 1},
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["check_id", "status", "reason"],
        "properties": {
          "check_id": {"type": "string", "minLength": 1},
          "status": {"enum": ["PASS", "BLOCK"]},
          "reason": {"type": "string", "minLength": 1}
        }
      }
    },
    "capability_constraints": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["capability", "instrument", "side", "quantity", "idempotency_key"],
          "properties": {
            "capability": {"type": "string", "minLength": 1},
            "instrument": {"type": "string", "minLength": 1},
            "side": {"enum": ["BUY", "SELL"]},
            "quantity": {"type": "string", "minLength": 1},
            "idempotency_key": {"type": "string", "minLength": 1}
          }
        }
      ]
    },
    "evaluated_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": ["string", "null"], "format": "date-time"}
  }
}
